# Cooperative Gig Services Platform - Environment Variables Template
# Copy this file to .env and fill in your secure credentials
# NEVER commit real secret credentials or .env to Git

# Server Configuration
PROJECT_NAME="Cooperative Gig Services Platform API"
VERSION="1.0.0"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database & Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_service_role_or_anon_key

# Authentication & Security
JWT_SECRET=your_jwt_secret_key_here
ALGORITHM=HS256

# Google Maps API Key
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Razorpay Test Mode Credentials (NEVER commit live secrets)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
